---
import { Image } from 'astro:assets';
import SocialIcons from '../SocialIcons.astro';
import Title from '../atoms/Title.astro';
import './about.css';

import About1 from '../../assets/about-img-2.jpg';
---

<section class="section-about py-32" id="section-about">
	<div class="container wrapper">
		<div class="text-center">
			<h2 class="heading-primary">About Me</h2>
		</div>
		<div class="text-center">
			<h2 class="heading-secondary">this should be a brief bio</h2>
		</div>
		<div
			class="about-container grid grid-cols-1 md:grid-cols-2 gap-8 items-center"
		>
			<div class="about-text-1">
                <h1>Hi, I am Carbell Kofi Sarfo.</h1>
				<p class="mb-12">
					I’m a creative entrepreneur, content creator, web designer, and
					developer. On my journey, I share knowledge and document my experiences
					through YouTube and podcasts. 
                    
                    <br>
                    Currently, I serve as the Managing
					Director of Segula Global, an executive branding organization
					that transforms leaders into thought leaders. I’m passionate
					about learning, innovation, and inspiring others to take that
					first step toward their goals
				</p>
                <a
					href="./assets/files/Curriculum Vitae (Carbell Sarfo).pdf"
					target="blank"
					class="btn btn-red">Download CV</a
				>
			</div>
			<div class="about-image">
				<Image src={About1} alt="Carbell Sarfo" />
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	.section-about {
		border-bottom: 1px solid light gray;
	}

	///////////////////////////////////////////////
	//             MEDIA QUERIES
	/////////////////////////////////////////////////

	@media screen and (min-width: 769px) {
		.section-about {
			.about-text-1 {
				grid-area: aboutText-1;
			}
			.about-text-2 {
				grid-area: aboutText-2;
			}
			.about-text-3 {
				grid-area: aboutText-3;
			}
			.about-image {
				grid-area: aboutImage;
			}
			.about-container {
				grid-template-columns: 1fr 1fr;
				grid-template-areas:
					'aboutText-1 aboutImage'
					'aboutText-2 aboutImage'
					'aboutText-3 aboutImage';
			}
		}
	}

	@media screen and (max-width: 500px) {
		.section-about {
			text-align: center;
		}
	}
</style>
