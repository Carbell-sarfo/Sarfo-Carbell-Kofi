---
const {name} = Astro.props;
import { Image } from "astro:assets";
import Logo from "./../assets/logo.jpg"
---

<a href="/" class="profile">
    <div class="img__container">
        <Image
            class="logo"
            src={Logo}
            alt="Carbell Sarfo Logo"
        />
    </div>
    <h3 class="color__gradiente header__title">
        {name}
    </h3>
</a>














<style>

 .img__container {
	border-radius: 50%;
	overflow: hidden;
	transition: 0.35s transform;
}

 .img__container:hover {
	transform: scale(1.1);
}

 .profile {
	display: flex;
	border-radius: 50%;
	align-items: center;
	gap: 1.5rem;
}

.logo {
    width: 60px;
    height: auto;
}
</style>