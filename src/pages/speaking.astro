---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import { mainMenu } from "../components/data/menuData";
import Footer from "../components/Footer/Footer.astro";

import { Image } from "astro:assets";
import AboutImg from "../assets/speaker-about.png"

import Featured1 from "../assets/alx-ventures.png";
import Featured2 from "../assets/koforiduah-tech.png";
import Featured3 from "../assets/upsa.png";
import Featured4 from "../assets/comssa-upsa.png";
import Test1 from "../assets/testimonial-1.png"

import Type1 from "../assets/type-1.png"
import Type2 from "../assets/type-2.png"
import Type3 from "../assets/type-3.png"


---

<Layout title="Carbell Sarfo is a well groomed and practical speaker and workshop leader">

    <Header origin={mainMenu} />

    <!-- Section hero -->
