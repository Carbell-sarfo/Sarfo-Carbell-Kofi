            </div>
        </div>
    </section>
    <!-- end of section hero -->

    <!-- section message -->
    <section class="section-message">
        <div class="container wrapper">
            <div class="message-container">
                <div class="message">
                    <h3 class="mb-12">Lorem ipsum dolor, sit amet consectetur adipisicing elit. Reiciendis perspiciatis vel repellat, iure et accusantium?</h3>
                    <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Reiciendis, illo?</p>
                </div>
            </div>
        </div>
    </section>


    <!-- Section About -->
    <section class="section-about py-40">
        <div class="container wrapper">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-20 items-center">
                <div>
                    <Image src={AboutImg} alt="Carbell's headshot" />
                </div>
                <div class="col-span-2">
                    <h1 class="mb-8">Lorem ipsum dolor sit amet consectetur adipisicing elit. Et ex dolorem fugit velit.</h1>
                    <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Esse quasi distinctio possimus quis facere itaque rerum a magni, culpa obcaecati, ducimus totam pariatur error, illo labore. Modi nulla excepturi minus? Maiores mollitia laboriosam est nesciunt non? Expedita voluptatibus vitae distinctio.</p>
                </div>
            </div>
        </div>
    </section>    
    <!-- End of about section -->



    <!-- As featured section -->
    <section class="section-featured bg-white py-40">
        <div class="container wrapper">
            <div class="text-center">
                <h1 class="heading-primary text-black">As Featured In</h1>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 w-full items-center gap-20">
                <div class="featured-icon">
                    <Image src={Featured1} alt="Alx Ventures" />
                </div>
                <div class="featured-icon">
                    <Image src={Featured2} alt="Alx Ventures" />
                </div>
                <div class="featured-icon">
                    <Image src={Featured3} alt="Alx Ventures" />
                </div>
                <div class="featured-icon">
                    <Image src={Featured4} alt="Alx Ventures" />
                </div>
            </div>
        </div>
    </section>
    <!-- End of as features section -->


    <!-- My Testimonial --><!-- =============== SECTION TESTIMONIAL ================= -->
<section class="section-testimonials" id="testimonials">
	<div class="container wrapper">
		<div class="text-center">
			<h2 class="heading-primary">testimonials</h2>
		</div>
		<div class="text-center">
			<h2 class="heading-secondary">
				Here is what some client have to say
			</h2>
		</div>

		<div class="testimonials-container">
			<div class="testimonial fade">
				<Image
					src={Test1}
					alt="Sameul Botchwey"
					class="testimonial__img"
				/>
				<h4 class="testimonial__name">Dina Akpalu-Benson</h4>
				<p class="testimonial__text">
					"Carbell went above and beyond, traveling from Accra to Koforidua to support our mission of bridging the gap between TVET, digitalization, entrepreneurship, and sustainability. His session on Branding and Personal Development was not only insightful but also deeply impactful, equipping participants with the confidence and knowledge to position themselves effectively in their careers."
				</p>
			</div>

			<!-- Next and previous buttons -->
			<a class="prev" onclick="plusSlides(-1)">
				<i class="fa fa-chevron-left"></i>
			</a>
			<a class="next" onclick="plusSlides(1)">
				<i class="fa fa-chevron-right"></i>
			</a>
		</div>
		<!-- The dots/circles -->
		<div style="text-align:center">
			<span class="dot" onclick="currentSlide(1)"></span>
			<span class="dot" onclick="currentSlide(2)"></span>
			<span class="dot" onclick="currentSlide(3)"></span>
		</div>
	</div>
</section>
<!-- End of section testimonials -->


    <!-- Section Workshop types -->
