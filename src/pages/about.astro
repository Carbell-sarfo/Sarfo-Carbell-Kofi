---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import { mainMenu } from "../components/data/menuData";
import Footer from "../components/Footer/Footer.astro";

import Image from "astro/components/Image.astro";
import AboutImg from "./../assets/about-img-3.png"
import Podcast from "../components/Podcast.astro";
---

<Layout title="About Carbell Sarfo">

    <Header origin={mainMenu} />

    <!-- About BG -->
    <section class="section-hero">
        <div class="container wrapper">
            <div class="about-text">
                <h1>Ready to Inspire, Educate, and Transform?</h1>
                <p>Welcome to my space, where creativity meets strategy and innovation. Let’s explore my journey, passion, and the impact I’m working toward.</p>
            </div>
        </div>
    </section>
    <!-- end of about hero -->


    <!-- section mission -->
    <section class="section-mission">
        <div class="container wrapper">
            <div class="mission-container">
                <h3>My mission is simple: to empower you with insights, strategies, and inspiration to spark positive change. I strive to make learning accessible and engaging, to walk alongside you as we tackle challenges, and to prove that growth and success can be both fun and fulfilling
                </h3>
    
                <br>
                <p>I believe that every small step builds momentum, and together we can redefine what's possible. If I can help you avoid the pitfalls I’ve faced or inspire you to take that bold first step, then I’ve done my part to create a ripple of progress</p>
            </div>
        </div>
    </section>
    <!-- End of section mission -->


    <section class="section-about py-40">
        <div class="container wrapper">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-20 items-center">
                <div>
                    <Image src={AboutImg} alt="Carbell's headshot" />
                </div>
                <div class="col-span-2">
                    <p class="mb-8">I’m Carbell Kofi Sarfo, a creative entrepreneur, mentor, and storyteller at heart. My path has been guided by a love for learning, building, and empowering others. Whether it’s through my content creation, web design, or speaking engagements, I aim to leave a meaningful mark on the lives I touch.</p>

                    <p class="mb-8">Currently, I lead as the Managing Director of Segula Global, an executive branding organization where I help transform leaders into thought leaders. My work demands versatility—whether it’s aligning digital strategies, designing impactful interfaces, or inspiring audiences with a powerful speech.</p>

                    <p class="mb-8">While my roles span across leadership, graphic design, web development, and teaching, I don’t define myself by the things I’ve done. Instead, I focus on the journey and goals ahead. I believe skills can be taught, but personality drives real change. My passion lies in pushing boundaries, challenging norms, and fostering growth—both personally and professionally.</p>

                    <p class="mb-8">Where I am now is a stepping stone toward what I envision: a future where IT innovation and personal branding shape leaders and organizations. I’m on a mission to create, inspire, and instill confidence in others, reminding them that all it takes is the first step</p>
                </div>
            </div>
        </div>
    </section>

    

    <!-- section podcast -->
    <Podcast />


    <!-- Section youTube -->
     <section class="section-youtube">
        <div class="container wrapper">
            <iframe width="560" height="315" src="https://www.youtube.com/embed/3qtmpFjg3Tw?si=pZwz-baSjeemGkF2" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="yt"></iframe>
        </div>
     </section>
    
    
    
    <Footer />
</Layout>






<style lang="scss">
.section-hero {
    width: 100%;
    height: 90vh;
    background-image: url(./../assets/about-bg.png);
    background-size: cover;
    background-position: right;
    background-attachment: fixed;

    .about-text {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        max-width: 760px;
        margin-inline: auto;
        text-align: center;


        h1 {
            font-size: 5rem;
            font-weight: bold;
        }
    }
}



.section-mission {
    width: 100%;
    padding: 10rem 0;
    text-align: center;
    background-color: var(--clr-red);

    .mission-container {
        width: 100%;
        max-width: 850px;
        margin-inline: auto;
    }

    h3 {
        font-size: 2.5rem;
        font-weight: 700;
    }
}


.section-youtube {

    .yt {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
    }
}
</style>